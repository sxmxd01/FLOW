<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme (applied after the splash screen). Dark only, like the web app. -->
    <style name="Theme.FocusFlow" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ff_splash_bg</item>
        <item name="android:colorBackground">@color/ff_splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Launch theme: system splash (Android 12+ native, compat below). -->
    <style name="Theme.FocusFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ff_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.FocusFlow</item>
    </style>

    <!-- Invisible router activity for widget taps. -->
    <style name="Theme.FocusFlow.Trampoline" parent="android:Theme.NoDisplay">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
